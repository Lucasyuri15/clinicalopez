# Copie para .env.local (que NÃO vai para o Git) e preencha.
# Nunca cole estes valores no chat, em issues ou em prints.

# Variáveis PÚBLICAS do Supabase (não são segredo; vão para o navegador). São as ÚNICAS com
# prefixo NEXT_PUBLIC_. Painel: botão Connect do projeto. Estas duas vão para a Vercel.
NEXT_PUBLIC_SUPABASE_URL=
# Chave *publishable* (sb_publishable_…). NUNCA cole aqui a chave secret (sb_secret_…).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ATENÇÃO (Vercel): no app em produção/preview configure SOMENTE `DATABASE_URL` (além das
# duas variáveis públicas acima).
# `DIRECT_URL` (senha do dono `postgres`) e `MIGRATION_PROJECT_REF` são só para a sua
# máquina (migrações e testes) e NÃO devem ir para a Vercel.

# Pooler do Supabase (porta 6543), papel `app_backend`: usado pelo app em execução.
# Formato: postgresql://app_backend.<project-ref>:<senha>@<host-do-pooler>:6543/postgres
# O <project-ref> TEM de ser o mesmo de NEXT_PUBLIC_SUPABASE_URL (https://<project-ref>.supabase.co):
# senão o app recusa (evita Auth de um projeto e banco de outro). Preview → dev; Production → prod.
DATABASE_URL=

# Conexão direta (porta 5432), papel `postgres`: usada só para migrações (pnpm db:migrate)
# e pelos testes de integração. Nunca vai para a Vercel.
# Formato: postgresql://postgres:<senha>@db.<project-ref>.supabase.co:5432/postgres
# Se a sua rede não tiver IPv6 (a conexão direta do plano Free é só IPv6), use a
# "Session pooler" do painel (porta 5432, funciona por IPv4):
#   postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Projeto Supabase onde as migrações podem rodar (ref do projeto DEV). Falha fechada:
# sem isto, ou com DIRECT_URL de outro projeto, `pnpm db:migrate` recusa.
MIGRATION_PROJECT_REF=

# OPCIONAL. Cabeçalho HTTP com o IP do cliente, usado no limite de tentativas de login.
# Deixe em branco na Vercel (vale `x-real-ip`, que a plataforma define). Em outro host, aponte
# para o cabeçalho que o proxy DELE sobrescreve (nunca um que o próprio cliente consiga forjar:
# quem forja o IP foge do limite). Em lista (ex.: x-forwarded-for) vale a ÚLTIMA entrada.
# Sem cabeçalho (ex.: dev local) todos os acessos dividem um único balde "unknown".
CLIENT_IP_HEADER=
