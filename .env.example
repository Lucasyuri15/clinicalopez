# Copie para .env.local (que NÃO vai para o Git) e preencha.
# Nunca cole estes valores no chat, em issues ou em prints.

# ATENÇÃO (Vercel): no app em produção/preview configure SOMENTE `DATABASE_URL`.
# `DIRECT_URL` (senha do dono `postgres`) e `MIGRATION_PROJECT_REF` são só para a sua
# máquina (migrações e testes) e NÃO devem ir para a Vercel.

# Pooler do Supabase (porta 6543), papel `app_backend`: usado pelo app em execução.
# Formato: postgresql://app_backend.<project-ref>:<senha>@<host-do-pooler>:6543/postgres
DATABASE_URL=

# Conexão direta (porta 5432), papel `postgres`: usada só para migrações (pnpm db:migrate)
# e pelos testes de integração. Nunca vai para a Vercel.
# Formato: postgresql://postgres:<senha>@db.<project-ref>.supabase.co:5432/postgres
# Se a sua rede não tiver IPv6 (a conexão direta do plano Free é só IPv6), use a
# "Session pooler" do painel (porta 5432, funciona por IPv4):
#   postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Projeto Supabase onde as migrações podem rodar (ref do projeto DEV). Falha fechada:
# sem isto, ou com DIRECT_URL de outro projeto, `pnpm db:migrate` recusa.
MIGRATION_PROJECT_REF=
